# Docker build context exclusions for the worker image.

# Virtual environments
.venv
.venv_bench_mlx
venv

# Generated outputs
output
output.*

# IDE / OS
.DS_Store
.vscode
.idea

# Tests / local data
.pytest_cache
tests

# Build artifacts
*.egg-info
dist
build
__pycache__
*.pyc
*.pyo
*.pyd

# Git
.git
.gitignore

# Local environment
.env
.env.*

# Local media / caches / input data (can be very large)
input
input/
*.mov
*.mp4
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ttf
*.otf
*.woff
*.woff2

# Example / docs (not needed by worker)
examples
docs
*.md

# Keep worker README if needed later
!worker/README.md

# Karaoke render assets baked into the worker image (Dockerfile COPY sources).
# Note: files inside an excluded directory cannot be re-included, which is why
# `overlays/` itself is not listed above.
!gkda-yellow.mp4
!Logo-YellowDropShadow.png
!overlays/optical2_1080p30.mp4
!overlays/optical_1080p30_crf23.mp4
!legacy/karaoke/fonts/*.ttf
